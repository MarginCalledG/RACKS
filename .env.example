# ---------------------------------------------------------------------------
# Network. Testnet first.
# ---------------------------------------------------------------------------
VITE_CHAIN=testnet          # "testnet" | "mainnet"

# ---------------------------------------------------------------------------
# Contract addresses. NOT DEPLOYED YET — every one of these is a placeholder.
# The app boots without them and shows a "not configured" state per screen.
# ---------------------------------------------------------------------------
VITE_RACKS_ADDRESS=
VITE_CAYMAN_ADDRESS=
VITE_IRSAGENT_ADDRESS=
VITE_TAXSWAPPER_ADDRESS=
VITE_TWAPORACLE_ADDRESS=
VITE_WRACKS_ADDRESS=

# Trade routing. Swapping RACKS -> wRACKS is a config change, not a rewrite:
# set VITE_TRADE_TOKEN_ADDRESS to the wRACKS address and point the pair at the
# wRACKS/SPY pool. Nothing in src/ hardcodes which one is being traded.
VITE_TRADE_TOKEN_ADDRESS=   # defaults to VITE_RACKS_ADDRESS if blank
VITE_ROUTER_ADDRESS=        # Uniswap V2 Router02 on RH Chain
VITE_PAIR_ADDRESS=          # RACKS/SPY or wRACKS/SPY
VITE_SPY_ADDRESS=

# USDG — mainnet value from docs.robinhood.com/chain/contracts.
# Leave blank on testnet until the testnet deployment address is known.
VITE_USDG_ADDRESS=
