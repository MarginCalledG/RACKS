# ---------------------------------------------------------------------------
# Network. Testnet first.
# ---------------------------------------------------------------------------
VITE_CHAIN=testnet          # "testnet" | "mainnet"

# ---------------------------------------------------------------------------
# Contract addresses. NOT DEPLOYED YET — every one of these is a placeholder.
# The app boots without them and shows a "not configured" state per screen.
# ---------------------------------------------------------------------------
VITE_RACKS_ADDRESS=
VITE_CAYMAN_ADDRESS=
VITE_IRSAGENT_ADDRESS=
VITE_TAXSWAPPER_ADDRESS=
VITE_TWAPORACLE_ADDRESS=
VITE_WRACKS_ADDRESS=

# Trading is Uniswap V4. Zap is the only contract the UI calls for swaps: it
# owns the USDG <-> SPY <-> wRACKS route and the wrap/unwrap on both ends.
VITE_ZAP_ADDRESS=
VITE_V4SWAP_ADDRESS=        # only needed if you want to show the raw swapper
VITE_TWAPORACLEV4_ADDRESS=  # tax preview for the V4 pool
VITE_TAXHOOK_ADDRESS=       # the V4 hook that applies the trading tax
VITE_SPY_ADDRESS=

# USDG — mainnet value from docs.robinhood.com/chain/contracts.
# Leave blank on testnet until the testnet deployment address is known.
VITE_USDG_ADDRESS=

# ---------------------------------------------------------------------------
# Demo mode. Fills every screen with invented data so the design can be
# reviewed before the contracts exist. Renders a banner saying so.
# Never set this true on a build that points at real contracts.
# ---------------------------------------------------------------------------
VITE_DEMO_MODE=false
