# ---------------------------------------------------------------------------
# Network. Testnet first.
# ---------------------------------------------------------------------------
VITE_CHAIN=testnet          # "testnet" | "mainnet"

# ---------------------------------------------------------------------------
# Contract addresses. NOT DEPLOYED YET — every one of these is a placeholder.
# The app boots without them and shows a "not configured" state per screen.
# ---------------------------------------------------------------------------
VITE_RACKS_ADDRESS=
VITE_CAYMAN_ADDRESS=
VITE_IRSAGENT_ADDRESS=
VITE_TAXSWAPPER_ADDRESS=
VITE_TWAPORACLE_ADDRESS=
VITE_WRACKS_ADDRESS=

# Trading is Uniswap V2, one hop, RACKS directly in the pair. Approvals go to
# the router. The tax lives in the token and is previewed via TwapOracle.
#
# Live testnet deployment (chain 46630), verified on Blockscout:
#   VITE_RACKS_ADDRESS=0x851fA5B4a24756e8315cD7e4C0E0d11f8dfbECf5
#   VITE_CAYMAN_ADDRESS=0x04D61b763EC0E6F1620bd05Cf06EaA1e812d58cd
#   VITE_IRSAGENT_ADDRESS=0x1D3a3407882F304305b9bfe68e965001779f3e26
#   VITE_TWAPORACLE_ADDRESS=0x7853A52D85F6C5D887f67d5bA90c665f6fCE06f4
#   VITE_ROUTER_ADDRESS=0xda86191A4E2632E69d84FF97A57F8cEf643EBa08
#   VITE_PAIR_ADDRESS=0x5D35D6e94a5106C7c61a5FAD605863EDAd4aeF54
#   VITE_SPY_ADDRESS=0x45BD72Dd6a85784A467eB509cF2224222D6934ae
#   VITE_USDG_ADDRESS=0xf759F8d89C903e26687410DF6B8164759FC2e28c
VITE_ROUTER_ADDRESS=
VITE_PAIR_ADDRESS=
VITE_SPY_ADDRESS=

# --- removed architecture (Uniswap v4 + wRACKS). Leave blank. ---------------
VITE_ZAP_ADDRESS=
VITE_V4SWAP_ADDRESS=
VITE_TWAPORACLEV4_ADDRESS=
VITE_TAXHOOK_ADDRESS=
VITE_WRACKS_ADDRESS=

# USDG — mainnet value from docs.robinhood.com/chain/contracts.
# Leave blank on testnet until the testnet deployment address is known.
VITE_USDG_ADDRESS=

# ---------------------------------------------------------------------------
# Demo mode. Fills every screen with invented data so the design can be
# reviewed before the contracts exist. Renders a banner saying so.
# Never set this true on a build that points at real contracts.
# ---------------------------------------------------------------------------
VITE_DEMO_MODE=false
